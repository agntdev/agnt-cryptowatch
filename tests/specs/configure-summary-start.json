[
  {
    "name": "Configure summary",
    "steps": [
      {
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "Morning summaries are off."
            }
          }
        ],
        "send": {
          "callback": "configure_summary:start"
        }
      }
    ]
  }
  ,{
    "name": "Set the morning summary time",
    "steps": [
      { "send": { "callback": "configure_summary:start" }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "callback": "summary:time" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Send a local time like 08:00." } }] },
      { "send": { "text": "08:00" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Your morning summary is set for 08:00." } }] }
    ]
  }
]
