[
  {
    "name": "Set quiet hours",
    "steps": [
      {
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "Choose when alerts should stay quiet."
            }
          }
        ],
        "send": {
          "callback": "set_quiet_hours:start"
        }
      }
    ]
  }
  ,{
    "name": "Set quiet hours",
    "steps": [
      { "send": { "callback": "set_quiet_hours:start" }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "callback": "quiet:start" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Send the quiet-hours start time, like 22:00." } }] },
      { "send": { "text": "22:00" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Now send the end time, like 07:00." } }] },
      { "send": { "text": "07:00" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Quiet hours are set for 22:00–07:00." } }] }
    ]
  }
]
