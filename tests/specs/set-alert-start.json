[
  {
    "name": "Set alert",
    "steps": [
      {
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "Add a coin before setting an alert."
            }
          }
        ],
        "send": {
          "callback": "set_alert:start"
        }
      }
    ]
  }
  ,{
    "name": "Create a threshold alert",
    "steps": [
      { "send": { "callback": "add_coin:start" }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "callback": "coin:add:BTC" }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "callback": "coin:save:BTC" }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "callback": "set_alert:start" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Choose a coin for the alert." } }] },
      { "send": { "callback": "alert:coin:BTC" }, "expect": [{ "method": "sendMessage", "payload": { "text": "What kind of BTC alert do you want?" } }] },
      { "send": { "callback": "alert:type:threshold" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Send the price that should trigger this alert." } }] },
      { "send": { "text": "50000" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Alert when BTC reaches 50000?" } }] },
      { "send": { "callback": "alert:confirm" }, "expect": [{ "method": "sendMessage", "payload": { "text": "BTC will alert at 50000." } }] }
    ]
  }
]
